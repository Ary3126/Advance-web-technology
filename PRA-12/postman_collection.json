      }
    },
    {
      "name": "2. GET /api/health (Health Check & Uptime)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "Returns application health status, uptime, and database connection state"
      }
    },
    {
      "name": "3. GET / (API Root Status & Documentation)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/",
        "description": "Root endpoint returning practical information, CI status, and list of available routes"
      }
    },
    {
      "name": "4. POST /api/auth/register (User Registration)",
      "request": {
        "method": "POST",

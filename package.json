{
  "name": "advanced-web-frameworks-practicals",
  "version": "2.0.0",
  "description": "ADVANCED WEB DEVELOPMENT FRAMEWORKS (ITUE301) - Unified Master Project & Practicals 1 to 13",
  "scripts": {
    "dev:master-backend": "npm --prefix \"unified-master/backend\" start",
    "dev:master-frontend": "npm --prefix \"unified-master/frontend\" run dev",
    "build:master": "npm --prefix \"unified-master/frontend\" run build",
    "test:master": "npm --prefix \"unified-master/backend\" test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "dev:pra1-3": "npm --prefix \"pra-1 to 3\" run dev",
    "dev:pra6-backend": "node \"pra-6/backend/server.js\"",
    "dev:pra6-frontend": "npm --prefix \"pra-6/frontend\" run dev",
    "dev:pra6": "npm --prefix \"pra-6\" run dev",
    "dev:assignment-w4": "node \"assignment-w4/server.js\"",
    "dev:pra10": "npm --prefix \"PRA-10/backend\" start",
    "dev:pra11": "docker compose -f \"PRA-11/docker-compose.yml\" up --build",
    "dev:pra12": "node \"PRA-12/server.js\"",
    "dev:pra13-backend": "node \"PRA-13/backend/server.js\"",
    "dev:pra13-frontend": "npm --prefix \"PRA-13/frontend\" run dev",
    "test": "jest PRA-12/tests/tasks.test.js --runInBand",
    "test:pra12": "jest PRA-12/tests/tasks.test.js --runInBand",
    "test:pra13": "jest PRA-13/backend/tests/ai.test.js --runInBand",
    "test:broken": "jest --testMatch=\"**/broken.test.sample.js\" --runInBand",
    "lint": "eslint PRA-12/ PRA-13/backend/",
    "test:pra5": "node \"pra-4 to 5/test_api.js\"",
    "test:pra6": "node \"pra-6/test_fullstack.js\"",
    "test:assignment-w4": "node \"assignment-w4/test_maturity.js\""
  },
  "keywords": [
    "react-19",
    "express-5",
    "mongodb",
    "mongoose",
    "awt-practicals",
    "richardson-maturity-model",
    "hateoas",
    "node-cache",
    "event-emitter",
    "docker-compose",
    "github-actions",
    "ci-cd",
    "jest",
    "supertest",
    "ai",
    "openai",
    "gemini",
    "responsible-ai"
  ],
  "author": "Ary Patel",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "node-cache": "^5.1.2",
    "openai": "^7.45.1"
  }
}
